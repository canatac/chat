# /!\ Après toute modification de ce fichier : `docker compose restart chat`
#     (le .env est monté en lecture seule dans le conteneur et relu à chaque démarrage de l'app ;
#      un simple `docker compose up -d` ne suffit pas si l'image n'a pas changé)
# Vérification : docker compose logs chat | grep '\[config\]'

# Port d'écoute de l'application
PORT=4000
# Bind de publication du port (docker-compose) : 0.0.0.0 par défaut, 127.0.0.1 si derrière un reverse proxy externe
CHAT_BIND=0.0.0.0

# Secret de signature des tokens JWT (obligatoire en production) : générer avec `openssl rand -hex 32`
JWT_SECRET=change-me

# Noms des administrateurs (séparés par des virgules) : ils voient l'icône dashboard (conso LLM)
ADMIN_NAMES=

# Taille maximale d'un fichier déposé (Mo)
MAX_UPLOAD_MB=25

# --- LLM ---
# Provider : openai, mistral, openrouter, groq, deepseek, ollama, ... (API compatible OpenAI)
#            ou "anthropic" (API Messages d'Anthropic)
#            ou "openai-compatible" avec LLM_BASE_URL personnalisé (vLLM, LM Studio, etc.)
LLM_PROVIDER=openai-compatible
# URL de base de l'API (laisser vide = défaut du provider, ex. https://api.openai.com/v1)
LLM_BASE_URL=
# Clé API (inutile pour Ollama local)
LLM_API_KEY=
# Modèle à utiliser (obligatoire pour activer les commandes LLM)
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=1024
# Nombre de messages de contexte envoyés au LLM
LLM_CONTEXT_MESSAGES=50
# Prix du modèle en USD par million de tokens (optionnel ; sinon table intégrée pour les modèles connus).
# Les définir tous les deux force le prix affiché dans le dashboard admin.
# LLM_INPUT_PRICE_PER_1M=0.15
# LLM_OUTPUT_PRICE_PER_1M=0.60

# RAG : /ask et /solve injectent les extraits de documents les plus pertinents
RAG_TOP_K=5
RAG_CHUNK_SIZE=1200

# --- Appels d'équipe + transcription (STT) ---
# Un seul appel à la fois, WebRTC en mesh (OK jusqu'à ~5-6 participants)
# Provider STT compatible OpenAI : openai (whisper-1), groq (whisper-large-v3),
# ou serveur local (faster-whisper, whisper.cpp...) via STT_BASE_URL
STT_PROVIDER=openai
# STT_BASE_URL=https://api.openai.com/v1   (laisser vide = défaut du provider ; requis pour un serveur local)
# STT_API_KEY=...   (sinon LLM_API_KEY est réutilisée)
STT_MODEL=whisper-1
STT_LANGUAGE=fr
# Suivi du coût STT à la minute audio (dans la devise d'affichage du dashboard).
# Scaleway MaaS facture 0,003 €/minute audio pour whisper-large-v3 (soit ~0,0032 $/min).
# Laisser vide = pas de suivi de coût STT (la transcription reste gratuite à l'affichage).
# STT_COST_PER_AUDIO_MIN=0.0032

# Exemple Scaleway Model-as-a-Service (whisper-large-v3, 0,003 €/min, hébergé à Paris) :
# STT_PROVIDER=openai-compatible
# STT_BASE_URL=https://api.scaleway.ai/v1
# STT_API_KEY=<SCW_SECRET_KEY>   (clé secrète IAM Scaleway, console > IAM > API Keys)
# STT_MODEL=whisper-large-v3
# STT_LANGUAGE=fr
# STT_COST_PER_AUDIO_MIN=0.0032

# Taille max d'un enregistrement d'appel (Mo)
RECORDING_MAX_MB=200

# --- TURN (obligatoire pour que les appels fonctionnent entre réseaux différents :
#     mobile 4G/5G <-> box internet, etc. ; STUN seul ne suffit pas) ---
# coturn tourne dans docker-compose. Mettre l'IP PUBLIQUE de la VM.
# Security group Scaleway : ouvrir UDP 3478 et UDP 49160-49200 en entrée.
# TURN_EXTERNAL_IP=203.0.113.10
# TURN_URLS=turn:203.0.113.10:3478
# TURN_USERNAME=chat
# TURN_CREDENTIAL=change-me

# --- WireGuard (VPN : le PC et le téléphone ont une IP fixe dans le tunnel 10.66.66.0/24) ---
# Après `docker compose up -d`, récupérer la config du peer (QR code à scanner avec l'app WireGuard) :
#   docker compose logs wireguard        (LOG_CONFS=true)
#   ou volume wg-config : /config/peer_telephone/peer_telephone.conf + .png
# Security group : ouvrir UDP 51820 (0.0.0.0/0). Le trafic 443 du téléphone passe par le tunnel (wg0),
# donc la règle 443 peut rester limitée à l'IP publique du PC (/32).
# WG_SERVERURL=chat.tonentreprise.fr   (ou IP publique ; "auto" = détection)
# WG_PORT=51820
# WG_PEERS=pc,telephone

# --- /lien <url> : téléchargement de médias collés dans le chat (émissions radio, etc.) ---
# Liste blanche de domaines (séparés par des virgules, supporte *.exemple.fr). Vide = tous les domaines publics.
# Les IP privées/localhost/métadonnées cloud sont toujours bloquées (anti-SSRF).
# LINK_FETCH_ALLOWED_DOMAINS=proxycast.radiofrance.fr
# Plafond de taille téléchargée (Mo)
MAX_LINK_FETCH_MB=500
# "1" = autoriser les IP privées (tests locaux UNIQUEMENT, ne jamais mettre en prod)
# LINK_FETCH_ALLOW_PRIVATE=0

# Domaine pour le HTTPS via Caddy (profil "https" de docker-compose), ex. chat.monentreprise.fr
DOMAIN=
